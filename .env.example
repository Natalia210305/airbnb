# Αντιγράψτε σε .env.local και συμπληρώστε.

# iCal URLs (χωρισμένα με κόμμα) για συγχρονισμό διαθεσιμότητας:
#   Booking.com extranet → Τιμές & Διαθεσιμότητα → Συγχρονισμός ημερολογίων → Εξαγωγή ημερολογίου
#   Airbnb → Ημερολόγιο → Διαθεσιμότητα → Συγχρονισμός ημερολογίων → Εξαγωγή
ICAL_URLS=

# Η τελική διεύθυνση του site (για SEO / Open Graph), π.χ. https://mirandashouse.gr
# Αν μείνει κενή, στο Vercel χρησιμοποιείται αυτόματα η διεύθυνση παραγωγής του project.
NEXT_PUBLIC_SITE_URL=
